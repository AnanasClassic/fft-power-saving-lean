/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaChain18 : ℝ := 1 - 6727247/(2000000000:ℝ)

theorem alphaChain18_pos : 0 < alphaChain18 := by norm_num [alphaChain18]
theorem alphaChain18_lt : alphaChain18 < 1 := by norm_num [alphaChain18]

lemma envelope_monoChain18 (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expChain18 {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsChain18 (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaChain18)

lemma hillsChain18_eq_envelope : hillsChain18 = envelope alphaChain18 := rfl

lemma hillsChain18_pos (k : ℕ) : 1≤hillsChain18 k := envelope_pos alphaChain18 k

lemma hillsChain18_mono {a b : ℕ} (h : a≤b) : hillsChain18 a ≤ hillsChain18 b := envelope_monoChain18 alphaChain18 alphaChain18_pos.le h

lemma hillsChain18_le (k : ℕ) : hillsChain18 k ≤ k+1 := envelope_le alphaChain18 alphaChain18_lt.le k

lemma hillsChain18_real (k : ℕ) : (hillsChain18 k:ℝ) ≤ 2*((k:ℝ)+1)^alphaChain18 := envelope_real alphaChain18 alphaChain18_pos.le k

