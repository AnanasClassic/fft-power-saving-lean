  exact ⟨o,s,lunchChain18 a b id,hp,Skies.time_boundChain18 (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderChain18 : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsChain18 W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
