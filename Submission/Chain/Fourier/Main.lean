  exact ⟨o,s,lunchChain18 a b stretchChain18,hp,Skies.time_boundChain18 h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posChain18 hn)).2⟩⟩

