def speedChain18 (v : ℝ) (n : ℕ) := (n:ℝ)*(TmChain18 n)^v

lemma flight_littleChain18 {v : ℝ} (h : alphaChain18 < v) :
    flightChain18 =o[atTop] speedChain18 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopChain18.eventually_ge_atTop 1,dwarfChain18 TtopChain18 2
    (p:=v-alphaChain18) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmChain18 n := by linarith
  change ‖(n:ℝ)*TmChain18 n^alphaChain18*QmChain18 n^2‖ ≤ c*‖(n:ℝ)*TmChain18 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmChain18 n^alphaChain18)*(c*TmChain18 n^(v-alphaChain18)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmChain18 n^alphaChain18*TmChain18 n^(v-alphaChain18))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaChain18 + (v-alphaChain18)=v by ring] -- a+(v-a)

lemma speed_littleChain18 {u v : ℝ} (h : u < v) :
    speedChain18 u =o[atTop] speedChain18 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopChain18.eventually_ge_atTop 1,dwarfChain18 TtopChain18 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmChain18 n := by linarith
  change ‖(n:ℝ)*TmChain18 n^u‖ ≤ c*‖(n:ℝ)*TmChain18 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmChain18 n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmChain18 n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmChain18 n^u)*(c*TmChain18 n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmChain18 n^u*TmChain18 n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleChain18 : decimalTimeChain18 =o[atTop] nlogn := by
  have H := speed_littleChain18 decimal_rangeChain18.2
