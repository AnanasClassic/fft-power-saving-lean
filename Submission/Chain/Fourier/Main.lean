theorem transform_main_orderChain18 : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsChain18 W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
