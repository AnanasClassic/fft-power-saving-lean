lemma speed_paperChain18 : speedChain18 theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopChain18.eventually_ge_atTop 1,QtopChain18.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmChain18 n := by linarith
  have he' : 0<QmChain18 n := by linarith
  change ‖(n:ℝ)*TmChain18 n^theta‖ ≤ 1*‖(n:ℝ)*TmChain18 n^theta*QmChain18 n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltChain18])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundChain18 {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationChain18) :
    TimeBoundsChain18 (lunchChain18 a b N) := by
  have H := lunch_bigChain18 a b h
  have hp := H.trans_isLittleO (flight_littleChain18 alpha_thetaChain18)
  have hd := H.trans_isLittleO (flight_littleChain18 decimal_rangeChain18.1)
  have ht : (fun n => (lunchChain18 a b N n:ℝ)) =O[atTop] decimalTimeChain18 := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperChain18,ht,ht.trans_isLittleO decimal_littleChain18⟩

