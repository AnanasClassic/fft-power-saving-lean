/-- Rank multiset from a histogram, preserving multiplicity. -/
@[irreducible] def ofHist (l : List (ℕ × ℕ)) : Multiset ℕ :=
  (l.map fun b => Multiset.replicate b.2 b.1).sum

lemma mom_ofHist (t : ℝ) (l : List (ℕ × ℕ)) :
    mom t (ofHist l) = (l.map fun b => (b.2 : ℝ) * ((b.1 : ℝ) ^ t)).sum := by
  induction l with
  | nil => simp [ofHist]
  | cons b l ih =>
    have e : ofHist (b :: l) = Multiset.replicate b.2 b.1 + ofHist l := by simp [ofHist]
    rw [e, mom_add, mom_replicate, ih, List.map_cons, List.sum_cons]

lemma card_ofHist (l : List (ℕ × ℕ)) : Multiset.card (ofHist l) = (l.map Prod.snd).sum := by
  induction l with
  | nil => simp [ofHist]
  | cons b l ih =>
    have e : ofHist (b :: l) = Multiset.replicate b.2 b.1 + ofHist l := by simp [ofHist]
    rw [e, Multiset.card_add, Multiset.card_replicate, ih, List.map_cons, List.sum_cons]

lemma mom_one_ofHist (l : List (ℕ × ℕ)) :
    mom 1 (ofHist l) = ((l.map fun b => b.2 * b.1).sum : ℕ) := by
  rw [mom_ofHist]
  induction l with
  | nil => simp
  | cons b l ih =>
    rw [List.map_cons, List.sum_cons, ih, List.map_cons, List.sum_cons, Real.rpow_one]
    push_cast
    ring

def targetHist : List (ℕ × ℕ) := [(1, 712), (2, 288), (3, 144), (4, 3852), (5, 504), (6, 72), (7, 324), (8, 684), (9, 14276), (17, 416), (25, 416), (33, 416), (41, 416), (49, 416), (57, 416), (65, 416), (73, 416), (145, 208)]

