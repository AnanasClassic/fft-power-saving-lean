theorem finite_moment_strict :
    mom (1-C) (ofHist paidHist) < mom (1-C) (ofHist targetHist) :=
  paid_upper.trans_lt ((by norm_num : ((8317117183151043483 : ℝ) / 25000000000000) < ((8317117184441280297 : ℝ) / 25000000000000)).trans_le target_lower)

lemma target_pos : 0 < mom (1-C) (ofHist targetHist) :=
  (by norm_num : (0 : ℝ) < ((8317117184441280297 : ℝ) / 25000000000000)).trans_le target_lower

theorem alpha : mom (1-C) (ofHist paidHist) ≤
    (1 - (1 : ℝ)/10000000000) * mom (1-C) (ofHist targetHist) := by
  calc
    _ ≤ ((8317117183151043483 : ℝ) / 25000000000000) := paid_upper
    _ ≤ (1 - (1 : ℝ)/10000000000) * ((8317117184441280297 : ℝ) / 25000000000000) := by norm_num
    _ ≤ _ := mul_le_mul_of_nonneg_left target_lower (by norm_num)

lemma scale_lower : ((100839331968811 : ℝ) / 100000000000000) ≤ (12 : ℝ)^C := by
  rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 12)]
  have h1 : ((100839331968811 : ℝ) / 100000000000000) ≤ expLower (C * ((621226662447 : ℝ) / 250000000000)) := by
    norm_num [expLower, C, Finset.sum_range_succ, Nat.factorial]
  have h2 := expLower_le (C * ((621226662447 : ℝ) / 250000000000)) (by norm_num [C])
  refine (h1.trans h2).trans (Real.exp_le_exp.mpr ?_)
  rw [mul_comm (Real.log 12) C]
  exact mul_le_mul_of_nonneg_left log_lower_12 (by norm_num [C])

lemma scaled_target_lower : ((838692540785376930508702512816867 : ℝ) / 2500000000000000000000000000) ≤
    (12 : ℝ)^C * mom (1-C) (ofHist targetHist) := by
  have h := mul_le_mul scale_lower target_lower
    (by norm_num : (0 : ℝ) ≤ ((8317117184441280297 : ℝ) / 25000000000000))
    (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 12) C).le
  norm_num only [] at h ⊢
  convert h using 1 <;> norm_num

lemma paid_mass : mom 1 (ofHist paidHist) = 334704 := by
  rw [mom_one_ofHist]; norm_num [paidHist]

lemma target_count : Multiset.card (ofHist targetHist) = 24392 := by
  rw [card_ofHist]; decide

theorem gamma : (334704 : ℝ) ≤ (499/500 : ℝ) *
    ((12 : ℝ)^C * mom (1-C) (ofHist targetHist)) := by
  calc
    _ ≤ (499/500 : ℝ) * ((838692540785376930508702512816867 : ℝ) / 2500000000000000000000000000) := by norm_num
    _ ≤ _ := mul_le_mul_of_nonneg_left scaled_target_lower (by norm_num)

theorem completion : (24392 * 13 : ℝ) ≤ (19/20 : ℝ) *
    ((12 : ℝ)^C * mom (1-C) (ofHist targetHist)) := by
  calc
